{
  "name": "auto-charcuterie",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:wgsl": "node scripts/wgsl-lint.mjs engine/**/*.ts",
    "check:mesh": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs scripts/mesh-check.mts",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --test \"game/**/*.test.mts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint:wgsl && npm run check:mesh && npm run test"
  },
  "dependencies": {
    "@dimforge/rapier3d-simd-compat": "^0.19.3",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "wgpu-matrix": "^3.4.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@webgpu/types": "^0.1.71",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "typescript": "^5"
  }
}
